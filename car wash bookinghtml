========================= -->

<section class="carwash-header">

    <div>

        <p>GRAND LAHDA CAR WASH</p>

        <h1>Give Your Car the Care It Deserves</h1>

        <span>
            Book your car wash quickly and conveniently.
        </span>

    </div>

</section>


<!-- =========================
     BOOKING SECTION
========================= -->

<section class="carwash-section">

    <div class="carwash-container">


        <!-- LEFT SIDE -->

        <div class="carwash-info">

            <p class="small-title">
                OUR CAR WASH
            </p>

            <h2>
                Professional Car Care
            </h2>

            <p>
                Keep your vehicle clean and looking its best
                with our professional car wash services.
            </p>


            <div class="service-box">

                <span>🚿</span>

                <div>

                    <h3>Exterior Wash</h3>

                    <p>
                        Exterior cleaning and drying.
                    </p>

                </div>

            </div>


            <div class="service-box">

                <span>✨</span>

                <div>

                    <h3>Premium Wash</h3>

                    <p>
                        Exterior wash, interior cleaning
                        and dashboard treatment.
                    </p>

                </div>

            </div>


            <div class="service-box">

                <span>💎</span>

                <div>

                    <h3>Deluxe Wash</h3>

                    <p>
                        Full vehicle cleaning with
                        premium finishing.
                    </p>

                </div>

            </div>

        </div>


        <!-- RIGHT SIDE -->

        <div class="booking-card">

            <h2>
                Book Your Car Wash
            </h2>

            <p class="booking-subtitle">
                Complete the form below.
            </p>


            <form id="carWashForm">


                <!-- CUSTOMER NAME -->

                <div class="form-group">

                    <label for="customerName">
                        Full Name
                    </label>

                    <input
                        type="text"
                        id="customerName"
                        name="customerName"
                        placeholder="Enter your full name"
                        required
                    >

                </div>


                <!-- PHONE -->

                <div class="form-group">

                    <label for="phone">
                        Contact Number
                    </label>

                    <input
                        type="tel"
                        id="phone"
                        name="phone"
                        placeholder="Enter your phone number"
                        required
                    >

                </div>


                <!-- VEHICLE -->

                <div class="form-group">

                    <label for="vehicle">
                        Vehicle Type
                    </label>

                    <select id="vehicle" name="vehicle" required>

                        <option value="">
                            Select vehicle
                        </option>

                        <option value="Sedan">
                            Sedan
                        </option>

                        <option value="SUV">
                            SUV
                        </option>

                        <option value="Bakkie">
                            Bakkie
                        </option>

                        <option value="Minibus">
                            Minibus
                        </option>

                        <option value="Other">
                            Other
                        </option>

                    </select>

                </div>


                <!-- REGISTRATION -->

                <div class="form-group">

                    <label for="registration">
                        Vehicle Registration
                    </label>

                    <input
                        type="text"
                        id="registration"
                        name="registration"
                        placeholder="e.g. GP 123 456"
                        required
                    >

                </div>


                <!-- PACKAGE -->

                <div class="form-group">

                    <label for="package">
                        Car Wash Package
                    </label>

                    <select id="package" name="package" required>

                        <option value="">
                            Select package
                        </option>

                        <option value="Exterior Wash">
                            Exterior Wash - R50
                        </option>

                        <option value="Premium Wash">
                            Premium Wash - R80
                        </option>

                        <option value="Deluxe Wash">
                            Deluxe Wash - R120
                        </option>

                    </select>

                </div>


                <!-- DATE -->

                <div class="form-group">

                    <label for="date">
                        Booking Date
                    </label>

                    <input
                        type="date"
                        id="date"
                        name="date"
                        required
                    >

                </div>


                <!-- TIME -->

                <div class="form-group">

                    <label for="time">
                        Booking Time
                    </label>

                    <select id="time" name="time" required>

                        <option value="">
                            Select time
                        </option>

                        <option value="08:00">
                            08:00
                        </option>

                        <option value="09:00">
                            09:00
                        </option>

                        <option value="10:00">
                            10:00
                        </option>

                        <option value="11:00">
                            11:00
                        </option>

                        <option value="12:00">
                            12:00
                        </option>

                        <option value="13:00">
                            13:00
                        </option>

                        <option value="14:00">
                            14:00
                        </option>

                        <option value="15:00">
                            15:00
                        </option>

                        <option value="16:00">
                            16:00
                        </option>

                    </select>

                </div>


                <!-- SPECIAL REQUEST -->

                <div class="form-group">

                    <label for="message">
                        Special Request
                    </label>

                    <textarea
                        id="message"
                        name="message"
                        rows="4"
                        placeholder="Any special requests?"
                    ></textarea>

                </div>


                <!-- TOTAL -->

                <div class="booking-total">

                    <span>
                        Estimated Price
                    </span>

                    <strong id="washPrice">
                        R0
                    </strong>

                </div>


                <!-- BUTTON -->

                <button
                    type="submit"
                    class="booking-btn">

                    Confirm Car Wash Booking 🚗

                </button>

            </form>

        </div>

    </div>

</section>


